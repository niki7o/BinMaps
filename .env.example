# ─────────────────────────────────────────────────────────────
#  BinMaps — environment variable template
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in your own values in .env
#  3. Run:              docker-compose up --build
#  4. Open:             http://localhost:4300
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# SQL Server connection string.
# For local SQL Server:  Server=localhost;Database=BinMaps;Trusted_Connection=True;TrustServerCertificate=True
# For remote SQL Server: Server=YOUR_HOST;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true;
DB_CONNECTION_STRING=Server=localhost;Database=BinMaps;Trusted_Connection=True;TrustServerCertificate=True

# ── JWT ──────────────────────────────────────────────────────
# Use a long random string (32+ characters) for the key.
JWT_KEY=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET_KEY
JWT_ISSUER=BinMapsAPI
JWT_AUDIENCE=BinMapsClient

# ── External APIs ─────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
# Get a free key at https://developer.tomtom.com
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY

# ── CORS ─────────────────────────────────────────────────────
# Origin that the backend allows.  For local Docker: http://localhost:4300
ALLOWED_ORIGINS=http://localhost:4300
