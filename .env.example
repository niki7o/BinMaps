# ─────────────────────────────────────────────────────────────
#  BinMaps — environment variable template
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in your own values in .env
#  3. Run:              docker-compose up --build
#  4. Open:             http://localhost:4300
#
#  Variable names use ASP.NET Core's __ separator (A__B → config["A:B"]).
#  Single-quote values that contain special characters like $ or ;
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local SQL Server:
#   ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=BinMaps;Trusted_Connection=True;TrustServerCertificate=True
# Remote SQL Server (wrap in single quotes if password has $ or ;):
ConnectionStrings__DefaultConnection='Server=YOUR_HOST;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true;Trusted_Connection=False;'

# ── JWT ───────────────────────────────────────────────────────
# Use a long random string (32+ chars). Avoid # which is a comment char in .env
Jwt__Key=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET_KEY
Jwt__Issuer=BinMapsAPI
Jwt__Audience=BinMapsClient

# ── External APIs ─────────────────────────────────────────────
# Get a free key at https://openweathermap.org/api
ExternalAPIs__OpenWeatherMap__ApiKey=YOUR_OPENWEATHERMAP_API_KEY
# Get a free key at https://developer.tomtom.com
ExternalAPIs__TomTom__ApiKey=YOUR_TOMTOM_API_KEY

# ── CORS ──────────────────────────────────────────────────────
# ASP.NET Core reads AllowedOrigins; Python AI reads ALLOWED_ORIGINS
# For local Docker full-stack, both should be http://localhost:4300
AllowedOrigins=http://localhost:4300
ALLOWED_ORIGINS=http://localhost:4300
